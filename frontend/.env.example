# KubeRTSec Frontend Environment Variables
# Copy to .env.local (git-ignored) for local dev:
#   cp .env.example .env.local
#
# For production builds, set these in your CI/CD pipeline.

# ── Controller API ────────────────────────────────────────────────────────────
# URL of the KubeRTSec controller backend.
# Default (local dev):        http://localhost:8080
# In-cluster (same origin):   (leave empty — requests go to same host)
# External load balancer:     https://kubertsec.your-cluster.example.com
REACT_APP_API_URL=http://localhost:8080

# WebSocket URL (auto-derived from API_URL if not set)
# Default:  ws://localhost:8080/ws
# TLS:      wss://kubertsec.your-cluster.example.com/ws
# REACT_APP_WS_URL=ws://localhost:8080/ws

# ── Polling intervals (ms) ────────────────────────────────────────────────────
REACT_APP_STATS_INTERVAL=30000
REACT_APP_POD_INTERVAL=15000
REACT_APP_METRICS_INTERVAL=15000
REACT_APP_CHART_INTERVAL=3000

# ── Limits ────────────────────────────────────────────────────────────────────
REACT_APP_MAX_ALERTS=500

# ── App ───────────────────────────────────────────────────────────────────────
REACT_APP_VERSION=1.0.0
