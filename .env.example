# KubeRTSec — Environment Variables
# Run: cp .env.example .env
# Then: make setup-k8s && make dev

VERSION=1.0.0

# ── Controller ────────────────────────────────────────────────────────────────
LISTEN_ADDR=:8080
STORE_PATH=/data/alerts.db
RULES_PATH=/configs/rules/process_rules.yaml
ALLOWLIST_PATH=/configs/allowlist.yaml
RESPONSE_MODE=alert

# ── Kubernetes ────────────────────────────────────────────────────────────────
# Generated by: make setup-k8s  (creates kubeconfig-docker file)
# KUBECONFIG is set automatically in docker-compose.yml

# ── Prometheus (your real K8s Prometheus) ────────────────────────────────────
# Controller (inside Docker) reaches it via host port-forward
# Run: make pf-start  to activate port-forwards
PROMETHEUS_URL=http://host.docker.internal:9090

# ── Grafana (your real K8s Grafana) ──────────────────────────────────────────
# Internal URL (controller API calls) — via host port-forward
GRAFANA_URL=http://host.docker.internal:3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_TOKEN=

# Public URL shown in dashboard "Open Grafana ↗" button
GRAFANA_PUBLIC_URL=http://localhost:3001

# ── Frontend ──────────────────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:8080
REACT_APP_WS_URL=ws://localhost:8080/ws
