# KubeRTSec — Environment Variables
# Copy this file: cp .env.example .env
# Source it:      source .env

# ─────────────────────────────────────────────────────────────
# Controller
# ─────────────────────────────────────────────────────────────

# HTTP listen address
LISTEN_ADDR=:8080

# Rules file path
RULES_PATH=configs/rules/process_rules.yaml

# Allowlist file path
ALLOWLIST_PATH=configs/allowlist.yaml

# Alert store (BoltDB) — auto-created on first run
# Local dev:
STORE_PATH=/tmp/kubertsec-dev.db
# Production (DaemonSet):
# STORE_PATH=/var/lib/kubertsec/alerts.db

# ─────────────────────────────────────────────────────────────
# Agent
# ─────────────────────────────────────────────────────────────

# Response mode:
#   detect  → log only, no network calls, no kills
#   alert   → log + send to controller
#   enforce → log + send + kill process group
RESPONSE_MODE=alert

# Controller endpoint (agent → controller)
KUBESHIELD_CONTROLLER=http://localhost:8080/event

# Node name (injected by Kubernetes downward API in production)
NODE_NAME=local-dev

# ─────────────────────────────────────────────────────────────
# Prometheus
# ─────────────────────────────────────────────────────────────

# Local dev (after: kubectl port-forward deployment/prometheus -n monitoring 9090:9090)
PROMETHEUS_URL=http://localhost:9090

# In-cluster (Kubernetes)
# PROMETHEUS_URL=http://prometheus-svc.monitoring.svc.cluster.local:9090

# ─────────────────────────────────────────────────────────────
# Grafana
# ─────────────────────────────────────────────────────────────

# Local dev (after: kubectl port-forward deployment/grafana -n monitoring 3001:3000)
GRAFANA_URL=http://localhost:3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123

# Service account token (required for Grafana 10+)
# Create at: http://localhost:3001/org/serviceaccounts
# → Add service account (role: Admin) → Add token → copy here
# GRAFANA_TOKEN=glsa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# In-cluster (Kubernetes)
# GRAFANA_URL=http://grafana-svc.monitoring.svc.cluster.local:3000
