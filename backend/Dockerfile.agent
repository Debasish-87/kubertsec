# backend/Dockerfile.agent — KubeRTSec eBPF Agent
# Must run privileged with access to /sys/kernel/btf/vmlinux
FROM golang:1.24 AS builder

RUN apt-get update && apt-get install -y \
    clang llvm libbpf-dev linux-headers-$(uname -r) \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Compile BPF object first
RUN clang -O2 -g -target bpf -D__TARGET_ARCH_x86 \
    -I/usr/include/bpf \
    -c bpf/execve.bpf.c \
    -o bpf/execve.bpf.o

ARG VERSION=1.0.0
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath \
    -ldflags="-s -w -X main.version=${VERSION}" \
    -o /bin/agent \
    ./cmd/agent

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    libbpf1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /bin/agent /agent
COPY --from=builder /src/bpf/execve.bpf.o /bpf/execve.bpf.o
COPY configs/ /configs/

EXPOSE 8080

# Agent requires privileged mode + hostPID + hostNetwork
ENTRYPOINT ["/agent"]
